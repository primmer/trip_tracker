{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && node lib/dev-server.js",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run build && node lib/dev-server.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "dev": "tsx src/dev-server.ts"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "firebase-functions-test": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  },
  "type": "module"
}
