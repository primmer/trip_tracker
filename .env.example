# =============================================================================
# Trip Tracker — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in all values for your own instance.
# Do NOT commit `.env` to version control.
#
# Backend (functions/) reads these at runtime via dotenv.
# Frontend (src/) reads only vars prefixed with VITE_ at build time.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — Instance Identity
# -----------------------------------------------------------------------------
# Your Firebase / Google Cloud project ID. Used by local dev server and setup
# scripts to target the correct Firestore database.
# Create at: https://console.firebase.google.com/
FIREBASE_PROJECT_ID=

# Your Firebase Storage bucket name (typically <projectId>.firebasestorage.app).
# Used by the local dev server. The production Functions runtime discovers
# this automatically.
FIREBASE_STORAGE_BUCKET=

# -----------------------------------------------------------------------------
# Strava API
# -----------------------------------------------------------------------------
# 1. Create an app at https://www.strava.com/settings/api
# 2. Copy Client ID and Client Secret below.
# 3. Authorize your app and extract a refresh_token (see README.md).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# Google Cloud / OAuth
# -----------------------------------------------------------------------------
# 1. Create a project in Google Cloud Console (or use the same as Firebase).
# 2. Enable APIs (see README.md for gcloud commands).
# 3. Create OAuth 2.0 credentials (Web application type).
# 4. Add http://localhost:3000/callback to Authorized redirect URIs.
# 5. Copy Client ID and Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# NOTE: GOOGLE_REFRESH_TOKEN is NOT stored here. After running the setup script
#       it is saved to Firestore at secrets/google_tokens.

# -----------------------------------------------------------------------------
# Client-Side Env Vars (exposed to browser — never put secrets here)
# -----------------------------------------------------------------------------

# Google Maps JavaScript API key.
# Restrict this key to your domain in the Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase client config (from Firebase Console > Project Settings > General).
# This is a JSON string containing: apiKey, authDomain, projectId, storageBucket,
# messagingSenderId, appId.
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# Arbitrary secret key to unlock admin mode. Append ?admin=<key> to any URL.
VITE_ADMIN_KEY=

# Sentry DSN for error tracking (optional — leave blank to disable).
VITE_SENTRY_DSN=
